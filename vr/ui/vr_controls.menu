		itemDef
		{
			name			vrview_hudsize
			group			vrview
			type			ITEM_TYPE_SLIDER
			text			"HUD Size"
			cvarfloat		"vr_hudFov" 50 30 90
			showValue
			valueStep		5
			rect			260 244 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"How much of your view the HUD takes up, in degrees from top to bottom"
			action
