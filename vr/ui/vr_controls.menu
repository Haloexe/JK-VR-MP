		itemDef
		{
			name			vrview_resolution
			group			vrview
			type			ITEM_TYPE_MULTI
			text			"Resolution"
			cvar			"vr_resolutionScale"
			cvarFloatList	{ "70%" 0.7 "80%" 0.8 "90%" 0.9 "100%" 1 "120%" 1.2 "140%" 1.4 }
			rect			260 314 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"Picture sharpness (100%: what the headset asks for; more is slower) - after a restart"
