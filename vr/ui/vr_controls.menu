			type			ITEM_TYPE_SLIDER
			text			"Menu Size (m)"
			cvarfloat		"vr_menuHeight" 2.2 1 4
			showValue
			rect			260 272 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
