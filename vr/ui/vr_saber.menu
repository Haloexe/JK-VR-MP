		//------------------------------------------------------------------------------------
		// the sabers, as they'll look (the Lightsaber page's own previews: ui_saber.c)
		//------------------------------------------------------------------------------------
		itemDef
		{
			name			saber
			group			models
			type			ITEM_TYPE_MODEL
			rect			0 -20 430 430
			asset_model		"models/weapons2/saber_reborn/saber_w.glm"
			isSaber			1
			model_angle		180
			model_rotation	20
			model_g2mins	0 0 0
			model_g2maxs	20 20 20
			model_fovx		75
			model_fovy		75
			visible			1
			decoration
		}

		itemDef
		{
			name			saber2
			group			models
			type			ITEM_TYPE_MODEL
			rect			0 40 430 430
			asset_model		"models/weapons2/saber_reborn/saber_w.glm"
			isSaber2		1
			model_angle		180
			model_rotation	20
			model_g2mins	0 0 0
			model_g2maxs	20 20 20
			model_fovx		75
			model_fovy		75
			visible			1
			cvarTest		"ui_sc_dual"
			showCvar
			{
				"1"
			}
			decoration
		}

		//------------------------------------------------------------------------------------
		// Back and Apply
		//------------------------------------------------------------------------------------
		itemDef
		{
			name			vrsc_backglow
			group			vrsc_highlights
			style			WINDOW_STYLE_SHADER
			rect			30 360 110 32
			background		"gfx/menus/menu_buttonback"
			forecolor		1 1 1 1
			visible			0
			decoration
		}

		itemDef
		{
			name			vrsc_backbutton
			type			ITEM_TYPE_BUTTON
			style			WINDOW_STYLE_EMPTY
			text			"Back"
			rect			30 360 110 32
			font			2
			textscale		1
			textalign		ITEM_ALIGN_CENTER
			textalignx		55
			textaligny		2
			forecolor		1 .682 0 1
			visible			1
			descText		"Back without changing your colors"
			mouseEnter
			{
				show		vrsc_backglow
			}
			mouseExit
			{
				hide		vrsc_backglow
			}
			action
			{
				play		"sound/interface/button1.wav" ;
				uiScript	vrSaberColor back
			}
		}

		itemDef
		{
			name			vrsc_applyglow
			group			vrsc_highlights
			style			WINDOW_STYLE_SHADER
			rect			160 360 110 32
			background		"gfx/menus/menu_buttonback"
			forecolor		1 1 1 1
			visible			0
			decoration
		}

		itemDef
		{
			name			vrsc_applyborder
			group			none
			style			WINDOW_STYLE_EMPTY
			rect			140 360 150 32
			forecolor		1 1 1 1
			border			1
			bordercolor		1 .682 0 1
			visible			1
			decoration
		}

		itemDef
		{
			name			vrsc_apply
			type			ITEM_TYPE_BUTTON
			style			WINDOW_STYLE_EMPTY
			text			"Apply"
			rect			160 360 110 32
			font			2
			textscale		1
			textalign		ITEM_ALIGN_CENTER
			textalignx		55
			textaligny		2
			forecolor		1 .682 0 1
			visible			1
			descText		"Use these colors"
			mouseEnter
			{
				show		vrsc_applyglow
			}
			mouseExit
			{
				hide		vrsc_applyglow
