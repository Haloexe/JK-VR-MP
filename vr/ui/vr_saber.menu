	//------------------------------------------------------------------------------------------
	// RGB Colors on the in-game Lightsaber page (its items go on "ingame_saber", under the
	// blade colours) - its glow one of that page's highlights, hidden as it opens
	//------------------------------------------------------------------------------------------
	menuDef
	{
		name				"vr_saber_ingame"
		visible				0
		rect				0 0 640 480

		itemDef
		{
			name			vr_saber_rgbglow
			group			highlights
			style			WINDOW_STYLE_SHADER
			rect			120 266 150 16
			background		"gfx/menus/menu_buttonback"
			forecolor		1 1 1 1
			visible			0
			decoration
		}

		itemDef
		{
			name			vr_saber_rgb
			group			none
			type			ITEM_TYPE_BUTTON
			style			WINDOW_STYLE_EMPTY
			text			"RGB Colors"
			rect			120 266 150 16
			font			4
			textscale		1
			textalign		ITEM_ALIGN_LEFT
			textalignx		0
			textaligny		0
			forecolor		.65 .65 1 1
			visible			1
			descText		"Any color for your blade, and a black core"
			mouseEnter
			{
				show		vr_saber_rgbglow
			}
			mouseExit
			{
				hide		vr_saber_rgbglow
			}
			action
			{
				play		"sound/interface/button1.wav" ;
				uiScript	vrSaberColor open 1
			}
		}
	}

