	//------------------------------------------------------------------------------------------
	// COMPANIONS on the Profile menu (its items go on "ingame_player", at the end of its row of
	// buttons; where the server has roleplay) - its glow one of the Profile's highlights, hidden as it opens
	//------------------------------------------------------------------------------------------
	menuDef
	{
		name				"vr_comp_profile"
		visible				0
		rect				0 0 640 480

		itemDef
		{
			name            vr_comp_profileglow
			group           highlights
			style           WINDOW_STYLE_SHADER
			rect            445 437 105 32
			background      "gfx/menus/menu_buttonback"
			forecolor       1 1 1 1
			visible         0
			decoration
		}

		itemDef
		{
			name            vr_comp_profilebutton
			group           none
			type            ITEM_TYPE_BUTTON
			style           WINDOW_STYLE_EMPTY
			rect            445 437 105 32
			text            "COMPANIONS"
			font            2
			textscale       0.9
			textstyle       3
			textalign       ITEM_ALIGN_CENTER
			textalignx      52
			textaligny      2
			forecolor       1 .682 0 1
			visible         1
			descText        "Your character's companions: make them, and choose who comes out with you"
			cvarTest        "ui_rpServer"
			showCvar
			{
				"1" ; "2" ; "3"
			}
			action
			{
				play		"sound/interface/button1.wav" ;
				uiScript		vrComp from 0 ;
				close		ingame_player ;
				open		vr_comp
			}
			mouseEnter
			{
				show		vr_comp_profileglow
			}
			mouseExit
			{
				hide		vr_comp_profileglow
			}
		}

	}
