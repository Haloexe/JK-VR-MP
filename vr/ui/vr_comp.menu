//----------------------------------------------------------------------------------------------
//
//	OpenJK VR: COMPANIONS
//
//	The Companions menu (vr_comp): the companions of the character you play - made, changed,
//	deleted, and which come out with you. Opened from the Profile menu (its COMPANIONS button)
//	or the Roleplay menu's Editor page. Its parts - the list, making one, a custom character -
//	are the items' groups (vc_...): the game's menu code (ui_vrcomp.c) shows what fits (the
//	part you're in, the look chosen, why it can't be used here...), fills the lists and the
//	ui_rpComp... cvars the text shows, keeps the preview ("character") as the companion will
//	look, and runs what the buttons ask (uiScript vrComp ...) - what needs the server goes
//	through the game ("rpui comp ...", cg_vrcomp.c).
//
//	A custom character is made with the Profile's own lists (feeders 19 to 23, on the ui_char_
//	cvars, put back as they were when the menu shuts) and its scripts (characterchanged,
//	char_skin, resetcharacterlistboxes), which work on this menu's "character", "headlistbox",
//	"torsolistbox", "lowerlistbox" and "colorbox".
//
//	vr_comp_profile is never shown itself: its items go on the Profile menu (ingame_player), in
//	the free place at the end of its row of buttons, where the server has roleplay.
//
//	feeder 68:	your companions		feeder 69:	what one can fight as		feeder 70:	models
//
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name                "vr_comp"
		visible             0
		fullScreen          0
		rect                20 25 600 440
		focusColor          1 1 1 1
		descX               450
		descY               438
		descScale           0.8
		descColor           1 .682 0 .8
		descAlignment       ITEM_ALIGN_CENTER

		onOpen
		{
			uiScript		vrComp opened
		}
		onClose
		{
			uiScript		vrComp closed
		}

		// the backdrop
		itemDef
		{
			name            vc_back
			group           none
			style           WINDOW_STYLE_SHADER
			rect            0 0 600 440
			background      "gfx/menus/menu_box_ingame"
			forecolor       1 1 1 1
			visible         1
			decoration
		}

		itemDef
		{
			name            vc_back2
			group           none
			style           WINDOW_STYLE_FILLED
			rect            4 4 592 432
			backcolor       0 0 .06 .55
			visible         1
			decoration
		}

