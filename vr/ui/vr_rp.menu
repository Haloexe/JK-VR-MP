		itemDef
		{
			name            rp_chat_help
			group           rp_chat
			type            ITEM_TYPE_TEXTSCROLL
			style           WINDOW_STYLE_FILLED
			rect            40 172 530 182
			text            "With roleplay on, what you say reaches those near you (15 metres, unless the server is set otherwise): the chat key, or Say... on the wheel (hold Y), which opens the keyboard in the headset.\n/me draws a saber shows as an action: * Kael Dorn draws a saber.\nOut of character, to everyone: the team chat key, or /ooc brb. A private word: /tell, as ever.\nIn the chat line, a line starting with / is a command, as in the console.\nLook at someone near, your weapon away, and their card shows who they are; Read their bio on the wheel's Roleplay ring."
			font            4
			textscale       1
			textalign       ITEM_ALIGN_LEFT
			textalignx      4
			textaligny      2
			lineHeight      15
			maxLineChars    80
			forecolor       .85 .85 .9 1
			backcolor       0 0 0 .35
			visible         1
		}

		//------------------------------------------------------------------------------------------
		// Help
		//------------------------------------------------------------------------------------------
		itemDef
		{
			name            rp_help_text
			group           rp_help
			type            ITEM_TYPE_TEXTSCROLL
			style           WINDOW_STYLE_FILLED
			rect            30 84 545 136
			text            "With roleplay on you play a character, of the Heroes, the Villains or the Neutral, with a description and a bio.\nACCOUNT: make one on the Characters page (or /new name password), then /login name password.\nCHARACTERS: pick one; what you wear and set in the Force menu stays with it - Grey too, where the server allows it.\nCOMPANIONS: up to 6 a character (Profile, Companions); 2 come out with you.\nWHEEL: hold Y. Up: Say... Right: Poses. Down: Companions. Left: Roleplay - a bio, a duel, give up, this menu.\nCHAT: talk reaches those near you; /me for actions; out of character: team chat or /ooc."
			font            4
			textscale       1
			textalign       ITEM_ALIGN_LEFT
			textalignx      4
			textaligny      2
			lineHeight      15
			maxLineChars    80
			forecolor       .85 .85 .9 1
			backcolor       0 0 0 .35
			visible         1
		}

		itemDef
		{
			name            rp_help_text2
			group           rp_help
			type            ITEM_TYPE_TEXTSCROLL
			style           WINDOW_STYLE_FILLED
			rect            30 222 545 136
			text            "DOWN: out of health, you go down instead of dying (pits, lava and the like still kill). Your faction gets you up: looking at you, holding use (the right grip) for 3 s. To respawn, hold attack (the trigger) for 1.5 s, or Give up on the wheel. A duel's loser goes down.\nNPCS: the light side's are with the Heroes, the dark side's with the Villains; Neutral are left alone until they attack one. Nobody harms someone down.\nSERVER: its owner turns roleplay on and off there.\nADMINS: an admin's cheats work here even with cheats off; their Admin page (top right) spawns NPCs; on People they make characters Grey Jedi or Force Masters."
			font            4
			textscale       1
			textalign       ITEM_ALIGN_LEFT
			textalignx      4
			textaligny      2
			lineHeight      15
			maxLineChars    80
			forecolor       .85 .85 .9 1
			backcolor       0 0 0 .35
			visible         1
		}

