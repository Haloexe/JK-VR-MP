	//------------------------------------------------------------------------------------------
	// ROLEPLAY under the in-game bar (its items go on "ingame"; where the server has roleplay)
	//------------------------------------------------------------------------------------------
	menuDef
	{
		name				"vr_rp_tab"
		visible				0
		rect				0 0 640 480

		itemDef
		{
			name            vr_rp_tabbutton
			group           none
			type            ITEM_TYPE_BUTTON
			style           WINDOW_STYLE_FILLED
			rect            5 33 104 22
			text            "ROLEPLAY"
			font            2
			textscale       0.7
			textstyle       3
			textalign       ITEM_ALIGN_CENTER
			textalignx      52
			textaligny      1
			forecolor       1 .682 0 1
			backcolor       0 0 .2 .75
			border          1
			bordercolor     .35 .45 .8 .9
			visible         1
			cvarTest        "ui_rpServer"
			showCvar
			{
				"1" ; "2"
			}
			action
			{
				play		"sound/interface/button1.wav" ;
				open		vr_rp
			}
			mouseEnter
			{
				setitemcolor	vr_rp_tabbutton backcolor .2 .45 .85 .9
			}
			mouseExit
			{
				setitemcolor	vr_rp_tabbutton backcolor 0 0 .2 .75
			}
		}

	}

	//------------------------------------------------------------------------------------------
	// Roleplay on Create game (its items go on "createserver", in the free row under the
	// server's settings: g_rp, for the game you host)
	//------------------------------------------------------------------------------------------
	menuDef
	{
		name				"vr_rp_create"
		visible				0
		rect				0 0 640 480

		itemDef
		{
			name            vr_rp_createback
			group           none
			style           WINDOW_STYLE_SHADER
			rect            10 135 180 20
			background      "gfx/menus/menu_blendbox"
			forecolor       1 1 1 1
			visible         0
			decoration
		}

		itemDef
		{
			name            vr_rp_createrow
			group           grpsettings
			type            ITEM_TYPE_YESNO
			text            "Roleplay:"
			cvar            "g_rp"
			rect            10 135 180 20
			textalign       ITEM_ALIGN_RIGHT
			textalignx      145
			textaligny      0
			font            4
			textscale       1
			forecolor       .615 .615 .956 1
			visible         1
			descText        "Characters, factions, local chat: players log in to theirs (OpenJK VR)"
			action
			{
				play		"sound/interface/button1"
			}
			mouseEnter
			{
				show		vr_rp_createback
			}
			mouseExit
			{
				hide		vr_rp_createback
			}
		}

	}
