//----------------------------------------------------------------------------------------------
//
//	OpenJK VR: ROLEPLAY
//
//	The Roleplay menu (vr_rp), opened from the wheel's Roleplay ring, the ROLEPLAY tab under the
//	in-game bar, or "ui_openmenu vr_rp". Its pages - Characters, Editor, People, Chat & cards,
//	Help, Server, and Admin for admins - are the items' groups (rp_...): the game's menu code (ui_vrrp.c) shows the
//	page picked and, on it, what fits (logged in or not, playing a character or not...), fills
//	the lists and the ui_rp... cvars the text shows, and runs what the buttons ask (uiScript
//	vrRP ...) - what needs the server goes through the game ("rpui ...", cg_vrrp.c). The Editor's
//	Companions opens the Companions menu (vr_comp.menu); the Server page's Companions, their settings.
//
//	vr_rp_tab and vr_rp_create are never shown themselves: their items go on the in-game bar
//	(under it) and on Create game's settings (a free row), where the menus have room for them;
//	vr_rp_force's on the game's Force menu, for a Grey Jedi or a Force Master (ui_vrforce.c).
//
//	feeder 65:	your characters		feeder 66:	the people here		feeder 67:	NPCs and vehicles (Admin)
//	"password" (an edit field): what's typed shows as *s
//
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name                "vr_rp"
		visible             0
		fullScreen          0
		rect                20 58 600 410
		focusColor          1 1 1 1
		descX               270
		descY               446
		descScale           0.8
		descColor           1 .682 0 .8
		descAlignment       ITEM_ALIGN_CENTER

		onOpen
		{
			uiScript		vrRP opened
		}
		onClose
		{
			uiScript		vrRP closed
		}
		onESC
		{
			play			"sound/interface/esc.wav" ;
			uiScript		vrRP close
		}

		// the backdrop
		itemDef
		{
			name            rp_back
			group           none
			style           WINDOW_STYLE_SHADER
			rect            0 0 600 410
			background      "gfx/menus/menu_box_ingame"
			forecolor       1 1 1 1
			visible         1
			decoration
		}

		itemDef
		{
			name            rp_back2
			group           none
			style           WINDOW_STYLE_FILLED
			rect            4 4 592 402
			backcolor       0 0 .06 .55
			visible         1
			decoration
		}

