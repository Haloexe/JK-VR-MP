		{
			name            rp_help_text
			group           rp_help
			type            ITEM_TYPE_TEXTSCROLL
			style           WINDOW_STYLE_FILLED
			rect            30 84 545 270
			text            "With roleplay on you play a character: everyone sees its name, it sides with the Heroes, the Villains or the Neutral, and it has a description and a bio. Off, the game plays as ever.\nACCOUNT: make one on the Characters page (or /new name password), then log in (/login name password). Your password becomes a key on this PC and is never sent.\nCHARACTERS: make them on the Characters page and pick one to play. What you wear while playing it stays with it. Switching waits until you are out of a fight.\nEDITOR: its faction, description and bio.\nWHEEL: hold Y. Up: Say... Right: Poses. Down: Companions, to come. Left: Roleplay - read a bio, a duel, this menu. Rest on a ring to open it.\nCHAT: talk reaches those near you (15 m, unless the server is set otherwise); /me for actions; out of character: the team chat key or /ooc.\nSERVER: its owner turns roleplay on and off there."
			font            4
			textscale       1
			textalign       ITEM_ALIGN_LEFT
			textalignx      4
			textaligny      2
			lineHeight      15
			maxLineChars    80
			forecolor       .85 .85 .9 1
			backcolor       0 0 0 .35
			visible         1
		}

