			rect            0 4 600 24
			text            "ROLEPLAY"
			font            3
			textscale       0.9
			textalign       ITEM_ALIGN_CENTER
			textalignx      300
			textaligny      0
			forecolor       .549 .854 1 1
			visible         1
			decoration
		}

