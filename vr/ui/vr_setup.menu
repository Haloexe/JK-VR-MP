//----------------------------------------------------------------------------------------------
//
//	OpenJK VR: THE VR PAGE OF SETUP
//
//	The game's menu code (ui_vrsetup.c) puts a "VR" button on Setup - in the main menu and in
//	game - under the page's own (Video, Sound...), and the settings below where the page shows
//	the others', in this order. Where they go, and the font, size and colour of their text,
//	follow the page's own Sound settings, so their rects and fonts here don't matter there.
//
//	showValue:	the slider shows its value after it; the arrow keys move it a tenth at a time
//	YESNO:		Yes or No after it; clicking it, Enter or the arrow keys change it
//	MULTI:		its choice after it; clicking it, Enter or the arrow keys go to the next
//	BUTTON:		does what it says when clicked
//
//----------------------------------------------------------------------------------------------
{
	menuDef
	{
		name				"vr_setup"
		visible				0
		fullScreen			0
		rect				0 0 640 480

		itemDef
		{
			name			vr_lefthanded
			group			vrsetup
			type			ITEM_TYPE_YESNO
			text			"Left-Handed"
			cvar			"vr_leftHanded"
			rect			260 160 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"Guns and your saber in your left hand (its trigger attacks); the Force on the right grip, Use on the left"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_fingers
			group			vrsetup
			type			ITEM_TYPE_YESNO
			text			"Finger Tracking"
			cvar			"cg_vrFingers"
			rect			260 174 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"Your character's fingers follow yours: point, thumbs up, an open hand, a fist - everyone on this build sees them"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_grippress
			group			vrsetup
			type			ITEM_TYPE_MULTI
			text			"Grip Press"
			cvar			"vr_gripPress"
			cvarFloatList	{ "60%" 0.6 "70%" 0.7 "80%" 0.8 "85%" 0.85 "90%" 0.9 "95%" 0.95 }
			rect			260 181 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"How far a grip must be pressed for Use and the Force - a lighter squeeze only curls your fingers"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_bodybends
			group			vrsetup
			type			ITEM_TYPE_YESNO
			text			"Body Bends"
			cvar			"cg_vrBodyBend"
			rect			260 184 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"Standing still, your character leans, bows, turns and crouches as you do, feet planted - other VR players' as they do"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_saberinertia
			group			vrsetup
			type			ITEM_TYPE_SLIDER
			text			"Saber Inertia"
			cvarfloat		"cg_vrSaberInertia" 1 0 3
			showValue
			rect			260 188 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"How your blade's weight holds it back as you swing: 0, none - it's where you point it; up to 3, heavier"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_saberweight
			group			vrsetup
			type			ITEM_TYPE_SLIDER
			text			"Saber Weight"
			cvarfloat		"cg_vrSaberWeight" 1 0 2
			showValue
			rect			260 216 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"How strongly you feel your blade's weight as it swings: 0, not at all; up to 2, twice as much"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_vibration
			group			vrsetup
			type			ITEM_TYPE_SLIDER
			text			"Vibration"
			cvarfloat		"cg_vrHaptics" 1 0 2
			showValue
			rect			260 244 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"How strongly the controllers vibrate: 0, never; up to 2, twice as strongly"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_holsters
			group			vrsetup
			type			ITEM_TYPE_YESNO
			text			"Holsters"
			cvar			"cg_vrHolsters"
			rect			260 272 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"Your weapons hang on your body - squeeze a grip at a hip or over a shoulder to take one out, put one in, or swap (servers that have them)"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_sabergrip
			group			vrsetup
			type			ITEM_TYPE_MULTI
			text			"Saber Grip"
			cvar			"cg_vrGripHold"
			cvarFloatList	{ "Hold" 1 "Toggle" 0 }
			rect			260 300 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"Hold: your saber stays in hand while you hold the grip; let go and it holsters. Toggle: squeeze to take or holster it"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_holsterreach
			group			vrsetup
			type			ITEM_TYPE_SLIDER
			text			"Holster Reach"
			cvarfloat		"cg_vrHolsterReach" 1 0.5 2
			showValue
			rect			260 328 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"How far from a holster your hand can be to use it: 1 as it comes, up to 2 (twice as far), down to 0.5 (half)"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_hiltshang
			group			vrsetup
			type			ITEM_TYPE_MULTI
			text			"Hilts Hang"
			cvar			"cg_vrHiltsDown"
			cvarFloatList	{ "Emitter Up" 0 "Emitter Down" 1 }
			rect			260 356 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"Which way your hilts hang in their holsters - taken out, they're held as you take them"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_holstermarkers
			group			vrsetup
			type			ITEM_TYPE_MULTI
			text			"Holster Markers"
			cvar			"cg_vrHolsterMarkers"
			cvarFloatList	{ "Off" 0 "Near a Hand" 1 "Always" 2 }
			rect			260 384 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"A faint ring at each holster: never, when a hand is near it, or always"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_quickdraw
			group			vrsetup
			type			ITEM_TYPE_YESNO
			text			"Quick Draw"
			cvar			"cg_vrQuickDraw"
			rect			260 412 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"Hold the trigger as you take a saber out of its holster and it lights as it comes out"
			action
			{
				play		"sound/interface/button1.wav" ;
			}
		}

		itemDef
		{
			name			vr_resetholsters
			group			vrsetup
			type			ITEM_TYPE_BUTTON
			text			"Reset Holsters"
			rect			260 440 340 14
			textalign		ITEM_ALIGN_RIGHT
			textalignx		174
			textaligny		0
			font			4
			textscale		1
			forecolor		0.65 0.65 1 1
			visible			0
			descText		"Your saber back on your right hip, a second on your left, your shoulders empty"
			action
			{
				play		"sound/interface/button1.wav" ;
				setcvar		cg_vrHolsterLayout "1,2,0,0" ;
			}
		}
	}
}
